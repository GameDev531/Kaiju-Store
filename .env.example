# ---------------------------------------------------------------------------
# KAIJU — environment. Copy to .env and fill in. NEVER commit .env.
# Every secret here is server-only; nothing prefixed NEXT_PUBLIC_ may hold one.
# ---------------------------------------------------------------------------

# Which deployment this is. NODE_ENV describes the build; APP_ENV describes where
# the process runs. Setting this to staging/production turns on the hard guards:
# no placeholder webhook secrets, no mock payment provider, no disabled rate
# limiting, https-only APP_URL.
APP_ENV="development"        # development | test | staging | production

# Database. SQLite for local dev; a PostgreSQL URL in every deployed environment.
DATABASE_URL="file:./dev.db"

# 32+ byte random string. Signs session cookies, CSRF tokens and file URLs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Public origin, used for absolute URLs, cookie scoping and CSRF origin checks.
APP_URL="http://localhost:3000"

# Private object storage root. In production this is an S3-compatible bucket
# with public access blocked; locally it is a directory outside the web root.
STORAGE_DIR="./var/storage"

# --- AI provider -----------------------------------------------------------
# Leave AI_PROVIDER=heuristic to run the deterministic local analyser, which
# needs no credentials and is what the test suite exercises.
AI_PROVIDER="heuristic"          # heuristic | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS="45000"

# --- Payments --------------------------------------------------------------
PAYMENT_PROVIDER="mock"          # mock | stripe | mercadopago
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"

# --- Shipping --------------------------------------------------------------
SHIPPING_PROVIDER="manual"       # manual | correios
SHIPPING_WEBHOOK_SECRET="dev-shipping-secret-change-me"
SHIP_ORIGIN_POSTAL_CODE="01310100"

# --- Operational -----------------------------------------------------------
LOG_LEVEL="info"
RATE_LIMIT_DISABLED="false"
